# Core
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret
REDIS_URL=redis://localhost:6379

# Isolated 360dialog sandbox only; never use a real patient number or a production key.
# D360_SANDBOX_API_KEY=your-sandbox-api-key
# D360_SANDBOX_RECIPIENT=your-test-phone-in-international-format-without-plus

# Optional PostgreSQL for the dashboard on/off switches (Sally always replies if unset)
# DATABASE_URL=postgresql://user:password@localhost:5432/sally

# Optional staff dashboard login (required before displaying the dashboard).
# Set a different password of at least 12 characters for each staff member.
# DASHBOARD_ACCOUNTS='{"alice":"replace-with-a-unique-password","bob":"replace-with-another-unique-password"}'
# Generate a session secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# DASHBOARD_SESSION_SECRET=paste-a-generated-secret-here
# Use false only for local HTTP testing; keep true on Railway.
# DASHBOARD_COOKIE_SECURE=false

# Telegram development bot (optional; standalone runner)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ALLOWED_USER_IDS=your-numeric-telegram-user-id

# Booking (optional — only if modules.booking is true)
GOOGLE_SERVICE_ACCOUNT_JSON=base64-encoded-service-account-json
# Used only by single-calendar configurations
GOOGLE_CALENDAR_ID=your-google-calendar-id
GOOGLE_CALENDAR_OWNER_EMAIL=your-calendar-email@gmail.com
# Consultant calendars used by the current multi-consultant configuration
CONSULTANT_1_CALENDAR_ID=first-consultant-calendar-id
CONSULTANT_2_CALENDAR_ID=second-consultant-calendar-id

# Payments (optional — only if modules.payments is true)
MP_ACCESS_TOKEN=your-mercadopago-access-token
MP_WEBHOOK_SECRET=your-mp-webhook-secret

# Internal
INTERNAL_SECRET=your-internal-secret
